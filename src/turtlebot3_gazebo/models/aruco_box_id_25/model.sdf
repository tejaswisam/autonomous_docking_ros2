<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="aruco_box_id_25">
    <link name="aruco_link">
      <pose>0 0 0.1 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.2 0.2 0.2</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.2 0.2 0.2</size>
          </box>
        </geometry>
      </visual>

      <!-- Marker face (front, upright) -->
      <visual name="aruco_marker_face">
        <pose>0 0.101 0 1.5708 0 3.14159</pose> <!-- 90° X, 90° Z -->
        <geometry>
          <plane>
            <size>0.18 0.18</size>
          </plane>
        </geometry>
        <material>
          <script>
            <uri>model://aruco_box_id_25/materials/scripts</uri>
            <uri>model://aruco_box_id_25/materials/textures</uri>
            <name>aruco/marker</name>
          </script>
        </material>
      </visual>

    </link>
  </model>
</sdf>

<?xml version="1.6" ?>
<sdf version="1.6">
  <model name="aruco_box">
    <pose>0 0 0 0 0 0</pose>
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <box>
            <size>0.2 0.2 0.2</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts</uri>
            <name>aruco/aruco_25</name> <!-- You can add your own textures later -->
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
